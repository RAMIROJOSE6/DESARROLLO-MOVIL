{
  "expo": {
    "name": "GeoCam",
    "slug": "geocam",
    "version": "5.0.0",
    "orientation": "portrait",
    "scheme": "geocam",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "co.edu.uniguajira.geocam"
    },
    "android": {
      "package": "co.edu.uniguajira.geocam",
      "edgeToEdgeEnabled": true
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "GeoCam usa la cámara para tomar fotos geolocalizadas.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "GeoCam usa tu ubicación para registrar dónde tomaste cada foto."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "GeoCam accede a tu galería para importar fotos."
        }
      ],
      "expo-sqlite",
      "expo-secure-store",
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
